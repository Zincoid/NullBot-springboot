# ══════ NullBot 部署配置文件 ══════ #
# 注: 用户使用 部署修改配置使用此配置文件.
# ════════════════════════════════ #

nullbot:
  # ─── 数据库 ───────── #
  database:
    url: jdbc:mysql://localhost:3306/nullbot          # 数据库地址
    username: root                                    # 数据库用户
    password:                                         # 数据库密码

  # ─── 日志 ─────────── #
  logging:
    level: INFO                                       # 日志级别
    path: ./output.log                                # 日志路径

  # ─── 连接 ─────────── #
  shiro:
    url: /napcat                                      # Ws 客户端点
    token:                                            # Ws 鉴权口令

  # ─── 基本 ─────────── #
  basic:
    ids:
      bot:                                            # 机器人账号
      admin:                                          # 管理员账号
      log:                                            # 日志群聊号
    cmd:
      prefix: "/"                                     # 指令前缀
      ignore-case: true                               # 指令忽略大小写
      limit: true                                     # 指令限速

  # ─── 网页 ─────────── #
  web:
    jwt:                                              ## 可选: Jwt 密钥
      # location: classpath:secret/JwtSignKey.jks     # jks 密钥路径
      # alias:                                        # jks 密钥别名
      # password:                                     # jks 密钥密码
      ttl: 24h                                        # jwt 生存时间

  # ─── 文件 ─────────── #
  file:
    storage:
      init: false                                     # 启动时文件同步
      root: ./files                                   # 文件管理根目录
    resource:
      mode: path                                      # 资源模式: path (default) | base64 | oss
      # base-url: http://localhost:8080               # 公网链接: oss 模式配置

  # ─── AI ──────────── #
  ai:
    chat:                                             ## AI 聊天配置
      repository: file                                # 存储模式: memory | db | file (default)
      config:
        max-history-length: 64                        # 最大历史长度
        max-tokens: 1024                              # 最大输出长度
        max-tool-calls: 5                             # 最大工具调用
        default-prompt: "你是一只猫娘，你的名字叫Null。"   # 默认提示词
      openai:
        active: deepseek                              # 默认供应商
        providers:
          - name: deepseek                            # 供应商名称
            api-url: https://api.deepseek.com         # OpenAI API 地址
            api-key:                                  # OpenAI API 密钥
            model:                                    # 模型名称
          # - name:
          #   api-url:
          #   api-key:
          #   model:
    tts:                                              ## TTS 语音配置
      api-url: http://localhost:8000                  # GSVI API 地址
      api-key: null                                   # GSVI API 密钥
      version:                                        # 模型版本
      model:                                          # 模型名称

  # ─── 浏览器 ────────── #
  chrome:
    driver:
      auto: true                                      # 自动驱动下载
      path:                                           # 自定驱动路径

  # ─── 搜图 ──────────── #
  saucenao:                                           # SauceNAO API
    api-key:                                          # 配置减少限流
